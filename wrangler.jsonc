{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "here-supply-co",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "here-supply-co-access",
      "database_id": "558dc15e-a4c5-4708-84f5-748bc2f17faa"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  }
}
